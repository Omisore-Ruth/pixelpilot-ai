# --- Backend (server/index.js) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Optional: override the model (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
# Your deployed frontend URL(s), comma-separated, for CORS
FRONTEND_URL=https://your-frontend.netlify.app
# Optional: generations allowed per visitor per minute (default: 10)
RATE_LIMIT_PER_MINUTE=10
PORT=5000

# --- Frontend (Vite) ---
# Where the frontend should send requests. Leave as-is for local dev.
VITE_API_URL=http://localhost:5000
