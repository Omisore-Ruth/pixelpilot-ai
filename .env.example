# --- Backend (server/index.js) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Optional: override the model (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash
# Optional: tried in order if the main model is busy or unavailable
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
# Your deployed frontend URL(s), comma-separated, for CORS
FRONTEND_URL=https://your-frontend.netlify.app
# Optional: requests allowed per user per minute
RATE_LIMIT_PER_MINUTE=10
ASSISTANT_LIMIT_PER_MINUTE=20
PORT=5000
# On your backend host (Render etc.), set these to the same values as the
# VITE_SUPABASE_* ones below. Locally the backend reads the VITE_ ones itself.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# --- Frontend (Vite) ---
# Where the frontend sends requests during local development.
# Don't set this on Vercel — there the site and API share one address.
VITE_API_URL=http://localhost:5000
# Supabase → Project Settings → API (Project URL and anon/publishable key)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
